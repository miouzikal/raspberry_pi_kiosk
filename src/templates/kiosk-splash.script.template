// Plymouth script for kiosk splash
// Displays splash.png scaled to fill and centered on screen

wallpaper = Image("splash.png");
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
wallpaper_width = wallpaper.GetWidth();
wallpaper_height = wallpaper.GetHeight();

// Scale image to fill the screen (cover mode)
scale_x = screen_width / wallpaper_width;
scale_y = screen_height / wallpaper_height;
scale = Math.Max(scale_x, scale_y);

scaled = wallpaper.Scale(
    wallpaper_width * scale,
    wallpaper_height * scale
);

sprite = Sprite(scaled);
sprite.SetX(Window.GetX() + (screen_width - scaled.GetWidth()) / 2);
sprite.SetY(Window.GetY() + (screen_height - scaled.GetHeight()) / 2);
sprite.SetZ(0);

// Set background to black to avoid white flash
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
